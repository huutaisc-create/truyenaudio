// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- USER MANAGEMENT ---

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  name            String?
  image           String?
  password        String?
  googleId        String?   @unique
  role            String    @default("USER")
  chaptersRead    Int       @default(0)
  downloadCredits Float     @default(0)      // Cộng dồn float, dùng khi >= 1.0
  favoriteGenres  String[]  @default([])     // thể loại yêu thích
  lastCheckIn     DateTime? // Ngày điểm danh gần nhất (UTC midnight)
  currentStreak   Int       @default(0)      // Chuỗi ngày liên tiếp hiện tại
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  readingHistory     ReadingHistory[]
  library            Library[]
  reviews            Review[]
  comments           Comment[]
  commentLikes       CommentLike[]
  likes              Like[]
  nominations        Nomination[]
  chatMessages       ChatMessage[]
  storyRequests      StoryRequest[]
  creditTransactions CreditTransaction[]
  adminLogs          AdminLog[]          @relation("AdminLogs")
  userVips           UserVip[]
  payments           Payment[]
  fcmTokens          UserFcmToken[]
  // --- Social feature (thêm mới) ---
  roomMessages       RoomMessage[]
  chatRoomReads      ChatRoomRead[]
  notifications      Notification[]      @relation("NotifRecipient")
  // --- Kênh bài đăng "Tám Chuyện" ---
  channelPosts            ChannelPost[]
  channelPostLikes        ChannelPostLike[]
  channelPostComments     ChannelPostComment[]
  channelPostCommentLikes ChannelPostCommentLike[]
}

// --- CREDIT TRANSACTIONS (audit log) ---

model CreditTransaction {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type         String   // 'ADD_APP' | 'ADD_WEB' | 'SPEND'
  amount       Float    // +1.0 / +0.5 / -1.0
  balanceAfter Float    // snapshot số dư sau giao dịch, dễ đối soát

  note         String?  // vd: "Xem video rewarded", "Tải chương xyz"

  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

// --- STORY MANAGEMENT ---

model Story {
  id              String    @id @default(uuid())
  slug            String    @unique
  title           String
  author          String
  description     String?
  coverImage      String?
  status          String    @default("ONGOING")
  totalChapters   Int       @default(0)
  viewCount       Int       @default(0)
  ratingScore     Float     @default(0)
  ratingCount     Int       @default(0)
  followCount     Int       @default(0)
  likeCount       Int       @default(0)
  nominationCount Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Mốc "Mới Cập Nhật": thời điểm truyện được tạo HOẶC có chương mới nhất.
  // KHÔNG dùng updatedAt cho việc này — updatedAt bị @updatedAt bump mỗi lần
  // story.update() chạy, kể cả khi chỉ tăng viewCount lúc user đọc chương,
  // nên "Mới Cập Nhật" hoá ra là "vừa có người đọc". Cột này chỉ đổi khi
  // thêm chương mới (xem createChapter / bulk import / POST /api/admin/stories).
  lastChapterAt   DateTime  @default(now())

  // AI-generated SEO review (Gemini)
  aiReview        String?

  // Admin fields
  storyType       String    @default("ORIGINAL")  // "ORIGINAL" | "CONVERT" | "TRANSLATED"
  isCompleted     Boolean   @default(false)        // dành cho convert/dịch: đã hoàn thành chưa
  isHidden        Boolean   @default(false)        // admin ẩn khỏi public
  isFeatured      Boolean   @default(false)        // ghim lên mục Truyện Hot trang chủ
  featuredOrder   Int       @default(0)            // thứ tự ưu tiên hiển thị (nhỏ hơn = lên trước)
  sourceUrl       String?                          // link nguồn gốc (convert/dịch)
  translatorName  String?                          // tên dịch giả / converter

  chapters        Chapter[]
  genres          Genre[]
  reviews         Review[]
  libraryEntries  Library[]
  historyEntries  ReadingHistory[]
  comments        Comment[]
  likes           Like[]
  nominations     Nomination[]
  storyRequests   StoryRequest[]

  // Index cho listing /api/stories (loc isHidden + sap xep) & muc noi bat
  @@index([isHidden, updatedAt])
  @@index([isHidden, lastChapterAt])
  @@index([isHidden, viewCount])
  @@index([isHidden, ratingCount])
  @@index([isHidden, createdAt])
  @@index([isFeatured, featuredOrder])
}

model Chapter {
  id          String   @id @default(uuid())
  index       Int
  title       String
  contentUrl  String?
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  storyId     String
  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  
  historyEntries ReadingHistory[]
  
  @@index([storyId, index])
}

model Genre {
  id          String   @id @default(uuid())
  name        String
  type        String   @default("GENRE")
  description String?

  stories     Story[]

  @@unique([name, type])
}

// --- USER INTERACTION ---

model ReadingHistory {
  id          String   @id @default(uuid())
  visitedAt   DateTime @default(now())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  storyId     String
  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  
  chapterId   String?
  chapter     Chapter? @relation(fields: [chapterId], references: [id])

  @@unique([userId, storyId])
}

model Library {
  id          String   @id @default(uuid())
  addedAt     DateTime @default(now())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  storyId     String
  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId])
}

model Nomination {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  storyId     String
  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
}

model Like {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  storyId     String
  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId])
}

model Review {
  id          String   @id @default(uuid())
  rating      Int
  content     String
  createdAt   DateTime @default(now())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  storyId     String
  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
}

model Comment {
  id          String        @id @default(uuid())
  content     String
  likeCount   Int           @default(0)
  createdAt   DateTime      @default(now())

  // --- Social feature (thêm mới) ---
  parentId    String?       // null = comment gốc; reply LUÔN trỏ về gốc (nest 1 cấp)
  replyCount  Int           @default(0)
  status      CommentStatus @default(VISIBLE)
  updatedAt   DateTime      @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  storyId     String
  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  parent      Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[] @relation("CommentReplies")

  commentLikes CommentLike[]

  @@index([storyId, createdAt])
  @@index([storyId, parentId, createdAt])
  @@index([parentId, createdAt])
}

enum CommentStatus {
  VISIBLE
  DELETED
  HIDDEN
}

model CommentLike {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  commentId   String
  comment     Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
}

model StoryRequest {
  id          String   @id @default(uuid())
  title       String
  link        String?
  note        String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  storyId     String?
  story       Story?   @relation(fields: [storyId], references: [id])

  @@index([status, createdAt])
}

model ChatMessage {
  id          String   @id @default(uuid())
  storySlug   String
  content     String
  likeCount   Int      @default(0)
  createdAt   DateTime @default(now())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([storySlug, createdAt])
}

// --- ADMIN: Nhật ký hành động ---

model AdminLog {
  id         String   @id @default(uuid())
  adminId    String
  admin      User     @relation("AdminLogs", fields: [adminId], references: [id], onDelete: Cascade)
  action     String                          // "DELETE_STORY" | "ADJUST_CREDIT" | ...
  targetType String?                         // "STORY" | "USER" | "COMMENT" | "REVIEW"
  targetId   String?
  detail     String?                         // JSON string chi tiết
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([action, createdAt])
}

// --- ADMIN: Từ khóa cấm (blacklist comment/review) ---

model SpamKeyword {
  id        String   @id @default(uuid())
  keyword   String   @unique
  createdBy String
  createdAt DateTime @default(now())
}

// --- VIP SYSTEM ---

model VipPlan {
  id           String    @id @default(uuid())
  name         String                          // "VIP 1 tháng"
  price        Int                             // VNĐ
  durationDays Int
  benefits     Json                            // { noAds: bool, offlineUnlimited: bool, premiumVoices: bool }
  isActive     Boolean   @default(true)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())

  userVips  UserVip[]
  payments  Payment[]
}

model UserVip {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    String
  plan      VipPlan  @relation(fields: [planId], references: [id])
  startAt   DateTime
  endAt     DateTime
  source    String                            // "MOMO" | "VNPAY" | "ADMIN_GRANT"
  createdAt DateTime @default(now())

  @@index([userId, endAt])
}

// --- THANH TOÁN ---

model Payment {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId      String
  plan        VipPlan  @relation(fields: [planId], references: [id])
  amount      Int                            // VNĐ
  gateway     String                         // "MOMO" | "VNPAY"
  gatewayTxId String?  @unique              // mã giao dịch từ cổng thanh toán
  status      String   @default("PENDING")  // "PENDING" | "SUCCESS" | "FAILED" | "REFUNDED"
  rawCallback String?                        // JSON raw response từ gateway
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// --- DAILY TASK CONFIG ---

model DailyTaskConfig {
  id           String   @id @default(uuid())
  taskKey      String   @unique             // "CHECK_IN" | "LISTEN_10" | "WATCH_AD" | "COMMENT" | "REVIEW" | "NOMINATE"
  label        String                       // "Điểm danh hàng ngày"
  description  String?
  creditReward Float
  isActive     Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}

// --- PUSH NOTIFICATION ---

model PushNotification {
  id         String    @id @default(uuid())
  title      String
  body       String
  targetType String                          // "ALL" | "VIP" | "USER_IDS" | "STORY_FOLLOWERS"
  targetData String?                         // JSON: danh sách userId hoặc storyId
  status     String    @default("DRAFT")     // "DRAFT" | "SENT" | "FAILED"
  sentAt     DateTime?
  sentCount  Int       @default(0)
  createdBy  String
  createdAt  DateTime  @default(now())
}

model UserFcmToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String                          // "android" | "ios"
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─────────────────────────────────────────────
// Affiliate Popup System
// ─────────────────────────────────────────────
model AffiliateCampaign {
  id            String    @id @default(uuid())
  name          String                        // tên chiến dịch (nội bộ)
  imageUrl      String                        // banner popup
  targetUrl     String                        // link affiliate
  weight        Int       @default(1)         // tỷ trọng xoay vòng (weighted random)
  incentiveText String?                       // câu incentive hiển thị trên popup
  isActive      Boolean   @default(true)
  startAt       DateTime?                     // lịch chạy (tùy chọn)
  endAt         DateTime?
  impressions   Int       @default(0)         // đếm nhanh (denormalized)
  clicks        Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  events        AffiliateEvent[]
  clickSessions AffiliateClickSession[]
}

model AffiliateEvent {
  id         String            @id @default(uuid())
  campaignId String
  campaign   AffiliateCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  deviceId   String
  userId     String?
  type       String            // "IMPRESSION" | "CLICK"
  createdAt  DateTime          @default(now())

  @@index([campaignId, type, createdAt])
  @@index([createdAt])
}

model AffiliateClickSession {
  id         String            @id @default(uuid())
  campaignId String
  campaign   AffiliateCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  deviceId   String
  clickedAt  DateTime          @default(now())
  expiresAt  DateTime          // clickedAt + sessionDays; > now = đang trong session

  @@unique([deviceId, campaignId])
  @@index([deviceId, expiresAt])
}

model AffiliatePopupConfig {
  id                 String   @id @default("singleton")
  enabled            Boolean  @default(true)  // công tắc tổng hệ thống popup
  // Thời điểm hiển thị (admin bật/tắt)
  onAppOpen          Boolean  @default(true)
  onAfterChapters    Boolean  @default(false)
  chaptersThreshold  Int      @default(3)
  onEnterListen      Boolean  @default(false)
  onTabChange        Boolean  @default(false)
  // Nhịp độ & session
  cooldownMinutes    Int      @default(30)    // giãn cách giữa 2 lần popup
  sessionDays        Int      @default(7)     // chu kỳ click
  expiredWeightBoost Int      @default(3)     // nhân tỷ trọng cho link vừa hết session
  updatedAt          DateTime @updatedAt
}

// ─────────────────────────────────────────────
// SOCIAL: Chat phòng "tám chuyện" + Notification tương tác
// (Bảng thật tạo bằng SQL: prisma/social-migration.sql — KHÔNG migrate dev)
// ─────────────────────────────────────────────

model ChatRoom {
  id        String       @id @default(uuid())
  slug      String       @unique  // seed 1 row: "tam-chuyen"
  name      String
  type      ChatRoomType @default(PUBLIC)
  createdAt DateTime     @default(now())

  messages RoomMessage[]
  reads    ChatRoomRead[]
}

enum ChatRoomType {
  PUBLIC
  DIRECT
  GROUP
}

// Tin nhắn phòng chung — KHÁC ChatMessage (chat-theo-storySlug đã có)
model RoomMessage {
  id        String            @id @default(uuid())
  roomId    String
  userId    String
  content   String
  status    ChatMessageStatus @default(VISIBLE)
  createdAt DateTime          @default(now())

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@index([userId])
}

enum ChatMessageStatus {
  VISIBLE
  DELETED
  HIDDEN
}

// Mốc "đã đọc" của mỗi user trong 1 phòng → badge unread
model ChatRoomRead {
  roomId     String
  userId     String
  lastReadAt DateTime @default(now())

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
}

// Thông báo tương tác (reply/like/mention) — KHÁC PushNotification (admin broadcast)
model Notification {
  id           String           @id @default(uuid())
  recipientId  String
  type         NotificationType
  storyId       String?
  storySlug     String?          // để deep-link mở đúng truyện
  commentId     String?
  rootCommentId String?          // thread gốc cần mở (reply); = commentId nếu là comment gốc
  roomId        String?
  messageId    String?
  postId        String?          // bài đăng kênh — CÓ postId nghĩa là mở bài đăng,
                                 // không có thì mở truyện (xem social-migration-4.sql)
  preview      String?          // trích đoạn nội dung (hiện dưới câu thông báo)
  groupKey     String           // gộp: vd "like:comment_<id>"
  actorId      String?
  actorCount   Int              @default(1)
  isRead       Boolean          @default(false)
  lastPushedAt DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  recipient User @relation("NotifRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, isRead, updatedAt])
  // 2 index dưới KHÔNG khai báo được bằng Prisma (partial) → tạo bằng SQL trong migration:
  //   UNIQUE (recipientId, groupKey) WHERE isRead = false
  //   (updatedAt) WHERE isRead = false
}

enum NotificationType {
  COMMENT_REPLY
  COMMENT_LIKE
  CHAT_MENTION
}

// ── KÊNH BÀI ĐĂNG "TÁM CHUYỆN" ────────────────────────────────────────────────
// Admin đăng bài (text + ảnh), user thích và bình luận. Thay cho mô hình nhắn tin
// ngang hàng RoomMessage (bảng đó GIỮ LẠI, chỉ không dùng nữa).
// Bảng thật tạo bằng prisma/social-migration-4.sql — KHÔNG chạy `prisma migrate dev`.

model ChannelPost {
  id           String        @id @default(uuid())
  content      String
  images       String[]      @default([])   // URL ảnh đã nén WebP qua /api/upload
  status       CommentStatus @default(VISIBLE)
  likeCount    Int           @default(0)    // denormalize — khỏi COUNT(*) mỗi lần load feed
  commentCount Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  likes    ChannelPostLike[]
  comments ChannelPostComment[]

  // Index thật là partial (WHERE status = 'VISIBLE') → khai báo bằng SQL, xem migration.
  @@index([createdAt])
}

model ChannelPostLike {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId String
  post   ChannelPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

model ChannelPostComment {
  id         String        @id @default(uuid())
  content    String
  parentId   String?       // null = gốc; reply LUÔN trỏ về gốc (nest 1 cấp)
  replyCount Int           @default(0)
  likeCount  Int           @default(0)
  status     CommentStatus @default(VISIBLE)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  postId String
  post   ChannelPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  parent  ChannelPostComment?  @relation("ChannelPostCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies ChannelPostComment[] @relation("ChannelPostCommentReplies")

  commentLikes ChannelPostCommentLike[]

  @@index([postId, parentId, createdAt])
  @@index([parentId, createdAt])
}

model ChannelPostCommentLike {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  commentId String
  comment   ChannelPostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
}
